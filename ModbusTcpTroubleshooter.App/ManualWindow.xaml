<Window x:Class="ModbusTcpTroubleshooter.App.ManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual | Diagnóstico Modbus TCP" Width="1120" Height="760" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F4F7F9" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#18354B" Padding="20,14">
            <StackPanel><TextBlock Text="MANUAL TÉCNICO" Foreground="#9ED2EB" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="Diagnóstico Modbus TCP" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock Text="Operação, diagnóstico e interpretação de resultados" Foreground="#D7E5ED" Margin="0,3,0,0"/></StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#CBD5DC" BorderThickness="1" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Pesquisar no manual" FontWeight="SemiBold" Foreground="#18354B" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchBox" Height="31" Padding="6,5" TextChanged="SearchBox_TextChanged" ToolTip="Busca em títulos, palavras-chave e conteúdo; não diferencia acentos."/>
                        <TextBlock x:Name="SearchCount" Foreground="#657785" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="SearchResults" Visibility="Collapsed" SelectionChanged="SearchResults_SelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5" Width="265">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#18354B" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Section}" FontSize="11" Foreground="#347EA8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#657785" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="43"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TreeView x:Name="TopicTree" SelectedItemChanged="TopicTree_SelectedItemChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch"/>
            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5DC" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F4F7F9" BorderBrush="#CBD5DC" BorderThickness="0,0,0,1" Padding="8,5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="BackButton" Content="Voltar" Click="Back_Click" Margin="0,0,6,0" Padding="10,3" IsEnabled="False"/>
                                <Button x:Name="ForwardButton" Content="Avançar" Click="Forward_Click" Padding="10,3" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="PageLocation" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#526B7D" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                <ScrollViewer x:Name="ArticleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ArticlePanel" Margin="26,22,30,30"/>
                </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#E5EDF2" BorderBrush="#CBD5DC" BorderThickness="1,1,0,0" Padding="12,6">
            <TextBlock x:Name="FooterText" Foreground="#526B7D" FontSize="11" Text="Selecione um tópico à esquerda. F1 abre a ajuda contextual."/>
        </Border>
    </Grid>
</Window>
