<Window x:Class="ModbusTcpTroubleshooter.App.WriteRegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escrever ponto Modbus"
        Width="390"
        Height="335"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F2F4F1">
    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="14" Margin="12">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Escrita pela tabela do mapa" FontSize="15" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
            <TextBlock x:Name="ContextText" TextWrapping="Wrap" Foreground="#5B665F" Margin="0,0,0,12" />

            <TextBlock x:Name="StartAddressLabel" Text="Endereco inicial" Foreground="#17312B" />
            <TextBox x:Name="AddressTextBox" Margin="0,2,0,8" />

            <TextBlock x:Name="EndAddressLabel" Text="Endereco final" Foreground="#17312B" />
            <TextBox x:Name="EndAddressTextBox" Margin="0,2,0,8" />

            <TextBlock x:Name="ValueLabel" Text="Novo valor" Foreground="#17312B" />
            <TextBox x:Name="ValueTextBox" Margin="0,2,0,12" />

            <TextBlock x:Name="ValidationText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="82" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="OK" Width="92" Background="#17312B" Foreground="White" FontWeight="SemiBold" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
