<Window x:Class="ModbusTcpTroubleshooter.App.ConnectionSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection Settings"
        Width="420"
        Height="285"
        MinHeight="245"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <GroupBox Header="Connection settings" Padding="12" Margin="0,0,0,8">
            <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition x:Name="ScanRateRow" Height="30" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="AddressLabel" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Text="IP address" />
                    <TextBox x:Name="AddressTextBox" Grid.Column="1" Width="200" Height="23" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Text="Service port" />
                    <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Width="100" Height="23" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Text="Unit ID" />
                    <TextBox x:Name="UnitIdTextBox" Grid.Row="2" Grid.Column="1" Width="100" Height="23" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock x:Name="ScanRateLabel" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Text="Scan rate" />
                    <StackPanel x:Name="ScanRatePanel" Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="ScanRateTextBox" Width="100" Height="23" Margin="0" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
            </Grid>
        </GroupBox>
        <TextBlock x:Name="ValidationText" Grid.Row="1" Foreground="#B3261E" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="OK" Width="82" Height="26" Margin="0,0,14,0" IsDefault="True" Click="Confirm_Click" />
            <Button Content="Cancel" Width="82" Height="26" Margin="0" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
