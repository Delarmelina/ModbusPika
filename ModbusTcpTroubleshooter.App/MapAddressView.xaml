<UserControl x:Class="ModbusTcpTroubleshooter.App.MapAddressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="#F2F6FA">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#CDD8E0" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Área de dados" VerticalAlignment="Center" Foreground="#526B7D" Margin="0,0,8,0" />
                <ComboBox x:Name="TypeFilter" Width="170" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,16,0">
                    <ComboBoxItem Content="HR · Holding Registers" Tag="Holding Register" />
                    <ComboBoxItem Content="IR · Input Registers" Tag="Input Register" />
                    <ComboBoxItem Content="COIL · Saídas digitais" Tag="Coil" />
                    <ComboBoxItem Content="DI · Entradas digitais" Tag="Discrete Input" />
                </ComboBox>
                <TextBlock Text="Ir ao endereço" VerticalAlignment="Center" Foreground="#526B7D" Margin="0,0,8,0" />
                <TextBox x:Name="AddressSearch" Width="75" Margin="0,0,6,0" ToolTip="Endereço Modbus base zero (0–65535)" />
                <Button Content="Localizar" Click="Jump_Click" />
                <TextBlock x:Name="FilterMessage" Foreground="#B8463D" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#CDD8E0" BorderThickness="0,1,0,0" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PreviousPage" Content="Anterior" Click="Previous_Click" /><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="5,0,10,0" /><Button x:Name="NextPage" Content="Próxima" Click="Next_Click" /></StackPanel>
                <TextBlock Text="Verde: OK · Amarelo: leitura parada · Cinza: não lido · Azul: local · Vermelho: falha | Duplo clique: editar" Foreground="#526B7D" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <Grid>
            <TextBlock x:Name="EmptyMessage" Text="Nenhum endereço configurado nesta área de dados." Foreground="#637F92" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Cells" Margin="6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Width="144" Height="110" Margin="4" Padding="0" Background="White" BorderBrush="#CEDBE4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" MouseDoubleClick="Cell_MouseDoubleClick" PreviewKeyDown="Cell_PreviewKeyDown" ToolTip="{Binding Detail}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="*" /><RowDefinition Height="26" /></Grid.RowDefinitions>
                                <Border Background="#E6EEF5" Padding="7,4"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Access}" Foreground="#718699" FontSize="10" /><TextBlock Text="{Binding AddressLabel}" Foreground="#254D6B" FontWeight="SemiBold" /></DockPanel></Border>
                                <StackPanel Grid.Row="1" Margin="7,3"><TextBlock Text="{Binding ValueText}" FontSize="22" Foreground="#173F5D" FontWeight="SemiBold" /><TextBlock Text="{Binding Name}" FontSize="10" Foreground="#637F92" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <Border Grid.Row="2" Background="#F6F9FB" Padding="7,4"><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding QualityColor}" Width="7" Height="7" Margin="0,0,5,0" /><TextBlock Text="{Binding QualityLabel}" Foreground="{Binding QualityColor}" FontSize="10" /></StackPanel></Border>
                            </Grid>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
