                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Resultado: " Foreground="#5B665F" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FullTestOverallStatus}" FontSize="15" FontWeight="SemiBold" Foreground="#17312B" VerticalAlignment="Center" />
                                            <TextBlock Text="    Etapas concluidas: " Foreground="#5B665F" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FullTestScore}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Rede" FontSize="11" FontWeight="SemiBold" Foreground="#5B665F" /><TextBlock Text="{Binding FullTestNetworkSummary}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Modbus" FontSize="11" FontWeight="SemiBold" Foreground="#5B665F" /><TextBlock Text="{Binding FullTestModbusSummary}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem x:Name="CommunicationMapTab" Header="Communication Map">
                    <Grid Margin="0,8,0,0">
                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10"
                            Visibility="{Binding IsClientMode, Converter={StaticResource BoolToVisibility}}">
