                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Type}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Inicio" Binding="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                            <DataGridTextColumn Header="Valor inicial" Binding="{Binding InitialValue, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                            <DataGridCheckBoxColumn Header="Inc" Binding="{Binding IncrementValue}" Width="45" />
                                            <DataGridCheckBoxColumn Header="R/W" Binding="{Binding Writable}" Width="50" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Visualizar mapa">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Mapa em memória do servidor simulado. Edite a coluna Valor para alterar as respostas." FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding ServerPoints}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="130" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="80" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Valor" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                            <DataGridTextColumn Header="Acesso" Binding="{Binding Access}" Width="65" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Atualizado" Binding="{Binding LastUpdatedAt}" Width="95" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="IssueLogsTab" Header="Avisos">
                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <TabControl>
                            <TabItem Header="Todos">
                                <DockPanel Margin="0,8,0,0">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" Background="#E9EEEB" BorderBrush="#C9D1CC" BorderThickness="1" Padding="8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="Registros: " Foreground="#5B665F" /><TextBlock Text="{Binding Diagnostics.Count}" FontWeight="SemiBold" /></StackPanel></Border>
                                        <StackPanel><TextBlock Text="Diagnósticos" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" /><TextBlock Text="Eventos e verificações registrados durante a sessão." Foreground="#65716A" Margin="0,2,0,0" /></StackPanel>
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="75" />
                                            <DataGridTextColumn Header="Nivel" Binding="{Binding Severity}" Width="75" />
                                            <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*" />
                                            <DataGridTextColumn Header="Recomendacao" Binding="{Binding Recommendation}" Width="220" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Avisos importantes">
                                <DockPanel Margin="0,8,0,0">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" Background="#E9EEEB" BorderBrush="#C9D1CC" BorderThickness="1" Padding="8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="Avisos consolidados: " Foreground="#5B665F" /><TextBlock Text="{Binding ImportantWarnings.Count}" FontWeight="SemiBold" /></StackPanel></Border>
                                        <StackPanel><TextBlock Text="Resumo de ocorrências importantes" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" /><TextBlock Text="Eventos semelhantes são agrupados para evitar uma lista repetitiva durante períodos longos." Foreground="#65716A" Margin="0,2,0,0" /></StackPanel>
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding ImportantWarnings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Qtd" Binding="{Binding Count}" Width="45" />
                                            <DataGridTextColumn Header="Nivel" Binding="{Binding Severity}" Width="75" />
                                            <DataGridTextColumn Header="Primeira" Binding="{Binding FirstSeenAt, StringFormat=HH:mm:ss}" Width="75" />
                                            <DataGridTextColumn Header="Ultima" Binding="{Binding LastSeenAt, StringFormat=HH:mm:ss}" Width="75" />
                                            <DataGridTextColumn Header="Resumo" Binding="{Binding Title}" Width="220" />
                                            <DataGridTextColumn Header="Ultimo detalhe" Binding="{Binding LatestDetail}" Width="*" />
                                            <DataGridTextColumn Header="Recomendacao" Binding="{Binding Recommendation}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Checklist">
                                <DockPanel Margin="0,8,0,0">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" Background="#E9EEEB" BorderBrush="#C9D1CC" BorderThickness="1" Padding="8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="Verificações: " Foreground="#5B665F" /><TextBlock Text="{Binding VerificationChecks.Count}" FontWeight="SemiBold" /></StackPanel></Border>
                                        <StackPanel><TextBlock Text="Verificações automáticas" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" /><TextBlock Text="Estado atual dos critérios monitorados pelo sistema." Foreground="#65716A" Margin="0,2,0,0" /></StackPanel>
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding VerificationChecks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="125" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
                                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Hora" Binding="{Binding LastCheckedAt}" Width="75" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </TabItem>

                <TabItem x:Name="TimelineTab" Header="Timeline">
                <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <TabControl>
                        <TabItem Header="Modbus">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Mensagens Modbus TCP" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding Traffic}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="95" />
                                        <DataGridTextColumn Header="Direcao" Binding="{Binding Direction}" Width="115" />
                                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="145" />
                                        <DataGridTextColumn Header="TID" Binding="{Binding TransactionId}" Width="55" />
                                        <DataGridTextColumn Header="UID" Binding="{Binding UnitId}" Width="55" />
                                        <DataGridTextColumn Header="FC" Binding="{Binding FunctionCode}" Width="50" />
                                        <DataGridTextColumn Header="Addr" Binding="{Binding StartAddress}" Width="60" />
                                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="55" />
                                        <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*" />
                                        <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" Width="260" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="TCP">
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <GroupBox Header="Configuracao da captura" Padding="8" Margin="0,0,0,6" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,6">
                                                <TextBlock Text="Interface de rede" Foreground="#5B665F" />
                                                <ComboBox ItemsSource="{Binding CaptureDevices}" SelectedItem="{Binding SelectedCaptureDevice}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,10,6">
                                                <TextBlock Text="Protocolo" Foreground="#5B665F" />
                                                <ComboBox ItemsSource="{Binding CaptureProtocols}" SelectedItem="{Binding SelectedCaptureProtocol}" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Content="Atualizar interfaces" Command="{Binding RefreshCaptureDevicesCommand}" />
                                                <Button Content="Aplicar filtro" Command="{Binding ApplyCaptureFilterCommand}" />
                                                <Button Content="Iniciar captura" Style="{StaticResource PrimaryActionButton}" Command="{Binding StartNetworkCaptureCommand}" />
                                                <Button Content="Parar captura" Command="{Binding StopNetworkCaptureCommand}" Margin="0" />
                                            </WrapPanel>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,10,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Endereco IP" Foreground="#5B665F" /><TextBox Text="{Binding CaptureIp, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Direcao do IP" Foreground="#5B665F" /><ComboBox ItemsSource="{Binding CaptureDirections}" SelectedItem="{Binding SelectedCaptureIpDirection}" /></StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Porta" Foreground="#5B665F" /><TextBox Text="{Binding CapturePort, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                                <StackPanel Grid.Column="3"><TextBlock Text="Direcao da porta" Foreground="#5B665F" /><ComboBox ItemsSource="{Binding CaptureDirections}" SelectedItem="{Binding SelectedCapturePortDirection}" /></StackPanel>
                                            </Grid>
                                            <DockPanel Grid.Row="2" Grid.ColumnSpan="3">
                                                <TextBlock DockPanel.Dock="Left" Text="Filtro de captura (BPF):" Foreground="#5B665F" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Text="{Binding GeneratedCaptureFilter}" IsReadOnly="True" />
                                            </DockPanel>
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox Header="Filtros da lista de pacotes" Padding="8" Margin="0,0,0,5" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Origem contem" Foreground="#5B665F" /><TextBox Text="{Binding SourceColumnFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Destino contem" Foreground="#5B665F" /><TextBox Text="{Binding DestinationColumnFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Protocolo contem" Foreground="#5B665F" /><TextBox Text="{Binding ProtocolColumnFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock Text="Informacao contem" Foreground="#5B665F" /><TextBox Text="{Binding InfoColumnFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        </Grid>
                                    </GroupBox>
