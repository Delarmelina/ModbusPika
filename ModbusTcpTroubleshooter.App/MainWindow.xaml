                            </GroupBox>
                            <GroupBox Header="Avisos importantes" Padding="8" Margin="0,0,6,0" Background="White">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Ocorrencias consolidadas: " Foreground="#5B665F" /><TextBlock Text="{Binding ImportantWarnings.Count}" FontWeight="SemiBold" /></StackPanel>
                            </GroupBox>
                            <GroupBox Header="Atividade Modbus" Padding="8" Background="White">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Mensagens nesta sessao: " Foreground="#5B665F" /><TextBlock Text="{Binding Traffic.Count}" FontWeight="SemiBold" /></StackPanel>
                            </GroupBox>
                        </UniformGrid>
                        <GroupBox Grid.Row="3" Header="Resumo e atividade" Padding="10" Background="White">
