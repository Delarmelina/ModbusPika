                                         </StackPanel>
                                        </GroupBox>
                                        <Expander Header="Cobertura incompleta — não confundir com falha" IsExpanded="True" Margin="0,0,0,12">
                                         <StackPanel Margin="8"><TextBlock Text="{Binding TestCoverageCaption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                          <ItemsControl ItemsSource="{Binding TestCoverageGaps}"><ItemsControl.ItemTemplate><DataTemplate>
                                           <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Ver evidências" Click="OpenFinding_Click"/><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding EvidencePreview}" TextWrapping="Wrap" Foreground="#526B7D"/></StackPanel></DockPanel>
                                          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                         </StackPanel>
                                        </Expander>
                                        <WrapPanel Margin="0,0,0,12">
                                         <TextBlock Text="{Binding FullTestStartedAtText, StringFormat=Inicio: {0}}" Margin="0,0,18,0"/>
                                         <TextBlock Text="{Binding FullTestFinishedAtText, StringFormat=Termino: {0}}" Margin="0,0,18,0"/>
                                         <TextBlock Text="{Binding FullTestOkCount, StringFormat=OK: {0}}" Foreground="#247A4D" Margin="0,0,18,0"/>
                                         <TextBlock Text="{Binding FullTestWarningCount, StringFormat=Atencao: {0}}" Foreground="#A67400" Margin="0,0,18,0"/>
                                         <TextBlock Text="{Binding FullTestFailureCount, StringFormat=Falhas: {0}}" Foreground="#B3261E" Margin="0,0,18,0"/>
                                         <TextBlock Text="{Binding FullTestInconclusiveCount, StringFormat=Inconclusivas: {0}}" Margin="0,0,18,0"/>
                                         <TextBlock Text="{Binding FullTestNotApplicableCount, StringFormat=Nao aplicaveis: {0}}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding FullTestCoverage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <Border Background="#F4F7F9" BorderBrush="#CBD5DC" BorderThickness="1" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Status geral" Foreground="#657785" /><TextBlock Text="{Binding FullTestOverallStatus}" FontSize="18" FontWeight="SemiBold" Foreground="#18354B" /><TextBlock Text="{Binding FullTestScore}" Foreground="#657785" /></StackPanel></Border>
                                            <Border Background="#F4F7F9" BorderBrush="#CBD5DC" BorderThickness="1" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Rede e dispositivos" Foreground="#657785" /><TextBlock Text="{Binding FullTestNetworkSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#18354B" /></StackPanel></Border>
                                            <Border Background="#F4F7F9" BorderBrush="#CBD5DC" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="Modbus" Foreground="#657785" /><TextBlock Text="{Binding FullTestModbusSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#18354B" /></StackPanel></Border>
                                        </UniformGrid>
                                        <UniformGrid Columns="2"><Border Background="#F4F7F9" BorderBrush="#CBD5DC" BorderThickness="1" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="Rotas e gateway" Foreground="#657785" /><TextBlock Text="{Binding FullTestRouteSummary}" TextWrapping="Wrap" Foreground="#18354B" /></StackPanel></Border><Border Background="#F4F7F9" BorderBrush="#CBD5DC" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="Banda e carga" Foreground="#657785" /><TextBlock Text="{Binding FullTestBandwidthSummary}" TextWrapping="Wrap" Foreground="#18354B" /></StackPanel></Border></UniformGrid>
                                    </StackPanel></ScrollViewer>
                                </TabItem>
   <TabItem x:Name="FullTestDevicesTab" Header="Dispositivos / rede">
                                    <DataGrid x:Name="DiscoveredDevicesGrid" Margin="0,8,0,0" ItemsSource="{Binding NetworkDiscoveryRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="DiscoveredDevicesGrid_MouseDoubleClick" PreviewMouseRightButtonDown="DiscoveredDevicesGrid_PreviewMouseRightButtonDown">
                                        <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}"><MenuItem Header="Adicionar como alvo..." Click="AddDiscoveredTarget_Click"/><Separator/><MenuItem Header="Verificar Modbus neste IP..." Click="VerifyDiscoveredDevice_Click"/></ContextMenu></DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="IpSortKey" Width="120" />
                                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceIdentity}" Width="145" />
                                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140" />
                                            <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="160" />
                                            <DataGridTextColumn Header="Papel provavel" Binding="{Binding RoleGuess}" Width="200" />
                                            <DataGridTextColumn Header="TCP aberto" Binding="{Binding OpenTcpPorts}" Width="110" />
                                            <DataGridTextColumn Header="Modbus confirmado" Binding="{Binding ConfirmedModbusPorts}" Width="125" />
                                            <DataGridTextColumn Header="Modbus observado" Binding="{Binding ObservedModbusPorts}" Width="125" />
                                            <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
   <TabItem x:Name="FullTestTopologyTab" Header="Topologia">
                                    <DockPanel Margin="8">
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBlock Text="Topologia observada" FontSize="16" FontWeight="SemiBold" Foreground="#18354B" />
                                            <TextBlock Text="{Binding TopologySummary}" TextWrapping="Wrap" Margin="0,4" />
                                            <TextBlock Text="{Binding TopologyCoverage}" TextWrapping="Wrap" Foreground="#657785" />
                                        </StackPanel>
                                        <TabControl>
                                            <TabItem Header="Diagrama"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><local:TopologyDiagram Links="{Binding TopologyLinks}" Devices="{Binding NetworkDiscoveryRows}" Neighbors="{Binding TopologyNeighbors}" ServerMode="{Binding FullTestIsServerMode}" /></ScrollViewer></TabItem>
                                            <TabItem Header="Evidências Modbus"><DataGrid ItemsSource="{Binding RelevantTopologyLinks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="170"/><DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="170"/><DataGridTextColumn Header="Evidencia" Binding="{Binding Evidence}" Width="150"/><DataGridTextColumn Header="Contagem" Binding="{Binding Count}" Width="80"/><DataGridTextColumn Header="Detalhes" Binding="{Binding Details}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
                                            <TabItem Header="Rotas ICMP"><DataGrid ItemsSource="{Binding TopologyRouteHops}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Alvo" Binding="{Binding Target}" Width="150"/><DataGridTextColumn Header="TTL / salto" Binding="{Binding Hop}" Width="80"/><DataGridTextColumn Header="IP respondeu" Binding="{Binding Address}" Width="150"/><DataGridTextColumn Header="Status ICMP" Binding="{Binding StatusLabel}" Width="*"/><DataGridTextColumn Header="Consulta (ms)" Binding="{Binding Milliseconds}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
                                            <TabItem Header="Vizinhos LLDP / CDP"><DataGrid ItemsSource="{Binding TopologyNeighbors}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="80"/><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Chassi" Binding="{Binding Chassis}" Width="150"/><DataGridTextColumn Header="Porta anunciada" Binding="{Binding Port}" Width="130"/><DataGridTextColumn Header="MAC" Binding="{Binding SourceMac}" Width="110"/><DataGridTextColumn Header="IP gestao" Binding="{Binding ManagementIp}" Width="120"/><DataGridTextColumn Header="TTL (s)" Binding="{Binding Ttl}" Width="65"/><DataGridTextColumn Header="Descricao" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
                                        </TabControl>
                                    </DockPanel>
                                </TabItem>
   <TabItem x:Name="FullTestMapResultsTab" Header="Mapa descoberto">
                                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding DiscoveredMapRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="145" />
                                            <DataGridTextColumn Header="Unit ID" Binding="{Binding UnitId}" Width="65" />
                                            <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="170" />
                                            <DataGridTextColumn Header="Inicio" Binding="{Binding StartAddress}" Width="70" />
                                            <DataGridTextColumn Header="Fim" Binding="{Binding EndAddress}" Width="70" />
                                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="60" />
                                            <DataGridTextColumn Header="Modo" Binding="{Binding DiscoveryMode}" Width="115" />
                                            <DataGridTextColumn Header="Confianca" Binding="{Binding Confidence}" Width="130" />
                                            <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
   <TabItem x:Name="FullTestReportTab" Header="Relatório">
                                    <DockPanel Margin="0,8,0,0">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Exportar resumo..." Command="{Binding SaveFullTestReportCommand}" Margin="0,0,6,0" ToolTip="Relatorio focado em resultados, achados e cobertura. Selecione MD ou PDF ao salvar."/><Button Content="Exportar completo..." Command="{Binding SaveDetailedFullTestReportCommand}" ToolTip="Inclui todas as etapas, inventario, mapa descoberto e conversas capturadas. Selecione MD ou PDF ao salvar."/></StackPanel><TextBlock Text="Relatório resumido desta execução" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                        <TextBox Text="{Binding FullTestReport}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                    </DockPanel>
                                </TabItem>
  </TabControl>
 </DockPanel>
</TabItem>
            </TabControl>
        </Grid>

        <StatusBar Grid.Row="3" Background="#E7ECE8" BorderBrush="#D5DDD6" BorderThickness="0,1,0,0" Padding="8,3">
            <StatusBarItem><TextBlock Foreground="#17312B"><Run Text="Visualização: " /><Run Text="{Binding SelectedModeLabel, Mode=OneWay}" /></TextBlock></StatusBarItem>
            <Separator />
            <StatusBarItem Visibility="{Binding IsClientMode, Converter={StaticResource BoolToVisibility}}"><TextBlock Foreground="#17312B"><Run Text="Alvo: " /><Run Text="{Binding TargetIp}" /><Run Text=":" /><Run Text="{Binding Port}" /></TextBlock></StatusBarItem>
            <StatusBarItem Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibility}}"><TextBlock Foreground="#17312B"><Run Text="Escuta: " /><Run Text="{Binding LocalIp}" /><Run Text=":" /><Run Text="{Binding Port}" /></TextBlock></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Foreground="#17312B"><Run Text="ID da unidade: " /><Run Text="{Binding UnitId}" /></TextBlock></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Text="{Binding RunningClientCount, StringFormat=Clientes em leitura: {0}}" Foreground="#17312B" /></StatusBarItem>
            <StatusBarItem><StackPanel Orientation="Horizontal"><TextBlock Text="Servidor: " Foreground="#17312B" /><TextBlock Style="{StaticResource ServerStateText}" /></StackPanel></StatusBarItem>
            <StatusBarItem><StackPanel Orientation="Horizontal"><TextBlock Text="Captura: " Foreground="#17312B" /><TextBlock Style="{StaticResource CaptureStateText}" /></StackPanel></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock Foreground="#5B665F" Text="{Binding Status}" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
