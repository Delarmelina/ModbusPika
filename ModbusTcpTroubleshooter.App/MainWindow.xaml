<Window x:Class="ModbusTcpTroubleshooter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModbusTcpTroubleshooter.App"
        mc:Ignorable="d"
        Title="Modbus TCP Diagnostic Tool" Height="840" Width="1260" MinHeight="680" MinWidth="980"
        Background="#E9EFF3" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:RequiredSelectionConverter x:Key="RequiredSelection"/>
        <DataTemplate x:Key="DiscoveredHostTemplate">
            <Button Style="{DynamicResource SidebarHostButton}" Click="OpenDiscoveredHost_Click" ToolTip="{Binding Notes}">
                <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Adicionar como alvo..." Click="AddDiscoveredTarget_Click"/><Separator/><MenuItem Header="Verificar Modbus neste IP..." Click="VerifyDiscoveredDevice_Click" /></ContextMenu></Button.ContextMenu>
                <DockPanel><Ellipse DockPanel.Dock="Left" Fill="{Binding EvidenceColor}" Width="8" Height="8" VerticalAlignment="Top" Margin="2,5,7,0"/>
                        <StackPanel><TextBlock Text="{Binding Ip}" FontWeight="SemiBold" Foreground="#18354B"/>
                            <TextBlock Text="{Binding AliasCaption}" FontSize="10" Foreground="#526B7D" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SidebarCaption}" FontSize="10" Foreground="#657785" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>
        <DrawingImage x:Key="ToolbarNewIcon">
            <DrawingImage.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M4,1 L16,1 21,6 21,24 4,24 Z"><GeometryDrawing.Pen><Pen Brush="#315C7A" Thickness="1.6" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#CFE6F3" Geometry="M16,1 L16,6 21,6 Z" />
                <GeometryDrawing Geometry="M7,11 L17,11 M7,15 L17,15 M7,19 L14,19"><GeometryDrawing.Pen><Pen Brush="#377DAD" Thickness="1.4" /></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup></DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ToolbarSaveIcon">
            <DrawingImage.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#3A83B7" Geometry="M2,2 L20,2 23,5 23,24 2,24 Z"><GeometryDrawing.Pen><Pen Brush="#285774" Thickness="1.5" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#E7F3FA" Geometry="M6,2 L18,2 18,10 6,10 Z" />
                <GeometryDrawing Brush="#FFFFFF" Geometry="M6,15 L19,15 19,24 6,24 Z" />
                <GeometryDrawing Brush="#264F6D" Geometry="M14,3 L17,3 17,9 14,9 Z" />
            </DrawingGroup></DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ToolbarClientIcon">
            <DrawingImage.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#315F83" Geometry="M1,3 L24,3 24,18 1,18 Z"><GeometryDrawing.Pen><Pen Brush="#254F6B" Thickness="1" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#EAF6FC" Geometry="M3,5 L22,5 22,16 3,16 Z" />
                <GeometryDrawing Geometry="M12.5,18 L12.5,22 M7,22 L18,22"><GeometryDrawing.Pen><Pen Brush="#315F83" Thickness="2" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#69B7D9" Geometry="M6,8 L15,8 15,10 6,10 Z" />
            </DrawingGroup></DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ToolbarServerIcon">
            <DrawingImage.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#315F83" Geometry="M4,1 L21,1 21,24 4,24 Z"><GeometryDrawing.Pen><Pen Brush="#254F6B" Thickness="1" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#EAF6FC" Geometry="M6,4 L19,4 19,9 6,9 Z M6,11 L19,11 19,16 6,16 Z M6,18 L19,18 19,22 6,22 Z" />
                <GeometryDrawing Brush="#49A4CC" Geometry="M8,6 L10,6 10,8 8,8 Z M8,13 L10,13 10,15 8,15 Z M8,19 L10,19 10,21 8,21 Z" />
            </DrawingGroup></DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="CompactToolButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#F4F6F5" />
            <Setter Property="BorderBrush" Value="#AEB9B3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202B26" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="BorderBrush" Value="#AEB9B3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderBrush" Value="#AEB9B3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#B9C3BE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="ColumnHeaderHeight" Value="29" />
            <Setter Property="AlternatingRowBackground" Value="#F5F7F6" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E3E8E5" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#B9C3BE" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="#E4E9E6" />
            <Setter Property="BorderBrush" Value="#B9C3BE" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Foreground" Value="#17312B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E4E70" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#173D59" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TestStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#E8EEF3" />
            <Setter Property="BorderBrush" Value="#B8C7D0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="Executando"><Setter Property="Background" Value="#E4F0FA" /><Setter Property="BorderBrush" Value="#9BC1DD" /></DataTrigger>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="OK"><Setter Property="Background" Value="#E4F3E9" /><Setter Property="BorderBrush" Value="#9ACBAA" /></DataTrigger>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="Atencao"><Setter Property="Background" Value="#FFF4DC" /><Setter Property="BorderBrush" Value="#E2C47C" /></DataTrigger>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="Falha"><Setter Property="Background" Value="#FBE9E8" /><Setter Property="BorderBrush" Value="#DFA39F" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TestStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18354B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="Executando"><Setter Property="Foreground" Value="#1B6697" /></DataTrigger>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="OK"><Setter Property="Foreground" Value="#247A4D" /></DataTrigger>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="Atencao"><Setter Property="Foreground" Value="#926700" /></DataTrigger>
                <DataTrigger Binding="{Binding FullTestOverallStatus}" Value="Falha"><Setter Property="Foreground" Value="#B3261E" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RibbonCommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="65" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="WorkspaceTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#526B7D" />
            <Setter Property="Background" Value="#EAF0F5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Grid><Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="#CFDAE3" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Border x:Name="ActiveLine" Height="3" VerticalAlignment="Bottom" Background="Transparent" /></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="White" /><Setter TargetName="ActiveLine" Property="Background" Value="#2F79AA" /><Setter Property="Foreground" Value="#214A69" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#F4F8FB" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActiveLine" Property="Background" Value="#2F79AA" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarRoleButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Foreground" Value="#18354B" />
        </Style>
        <Style x:Key="SidebarHostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ScanStateText" TargetType="TextBlock">
            <Setter Property="Text" Value="Parado" />
            <Setter Property="Foreground" Value="#6D756E" />
            <Style.Triggers><DataTrigger Binding="{Binding IsClientScanning}" Value="True"><Setter Property="Text" Value="Em execucao" /><Setter Property="Foreground" Value="#247A4D" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ServerStateText" TargetType="TextBlock">
            <Setter Property="Text" Value="Parado" />
            <Setter Property="Foreground" Value="#6D756E" />
            <Style.Triggers><DataTrigger Binding="{Binding IsServerRunning}" Value="True"><Setter Property="Text" Value="Em execucao" /><Setter Property="Foreground" Value="#247A4D" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CaptureStateText" TargetType="TextBlock">
            <Setter Property="Text" Value="Inativa" />
            <Setter Property="Foreground" Value="#6D756E" />
            <Style.Triggers><DataTrigger Binding="{Binding IsNetworkCaptureRunning}" Value="True"><Setter Property="Text" Value="Ativa" /><Setter Property="Foreground" Value="#247A4D" /></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F7F8F7" BorderBrush="#C9D1CC" BorderThickness="0,0,0,1" Padding="4,2">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="Novo diagnóstico" Click="NewSession_Click" />
                <MenuItem Header="Abrir configuração (.ffd)..." Command="{Binding OpenConfigurationCommand}" />
                <MenuItem Header="Salvar configuração" Command="{Binding SaveConfigurationCommand}" />
                <MenuItem Header="Salvar configuração como..." Command="{Binding SaveConfigurationAsCommand}" />
                <Separator />
                <MenuItem Header="Exportar caso de diagnóstico (.json)..." Command="{Binding SaveCaseCommand}" />
                <Separator /><MenuItem Header="Sair" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Conexões">
                <MenuItem Header="Cliente / Mestre" IsEnabled="{Binding CanUseClientOperations}">
                    <MenuItem Header="Gerenciar estação e servidores-alvo" Click="ShowClientStation_Click"/>
                    <MenuItem Header="Adicionar servidor-alvo..." Click="AddClientTarget_Click" />
                    <MenuItem Header="Configurar servidor-alvo selecionado..." Click="ConfigureClient_Click" IsEnabled="{Binding CanConfigureClient}" />
                    <MenuItem Header="Iniciar leitura" Command="{Binding StartClientScanCommand}" />
                    <MenuItem Header="Leitura única" Command="{Binding ReadOnceCommand}" />
                    <Separator />
                    <MenuItem Header="Desconectar" Command="{Binding DisconnectClientCommand}" />
                </MenuItem>
                <MenuItem Header="Servidor / Escravo">
                    <MenuItem Header="Configurar servidor..." Click="ConfigureServer_Click" IsEnabled="{Binding CanConfigureServer}" />
                    <MenuItem Header="Iniciar servidor..." Command="{Binding StartServerCommand}" />
                    <Separator />
                    <MenuItem Header="Parar servidor" Command="{Binding StopServerCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Exibir">
                <MenuItem x:Name="ConnectionsPaneMenuItem" Header="Painel de conexões" IsCheckable="True" IsChecked="True" Click="ToggleConnectionsPane_Click" />
                <MenuItem x:Name="DiscoveredDevicesMenuItem" Header="Dispositivos encontrados" IsCheckable="True" IsChecked="True" />
                <Separator />
                <MenuItem x:Name="ClientStationMenuItem" Header="Estação cliente (todos os alvos)" IsCheckable="True" IsChecked="True" Click="ShowClientStationView_Click"/>
                <MenuItem x:Name="CommunicationMapMenuItem" Header="Dispositivo selecionado: configuração e mapa" IsCheckable="True" IsChecked="True" Click="ShowCommunicationMap_Click" />
                <MenuItem x:Name="TimelineMenuItem" Header="Linha do tempo" IsCheckable="True" IsChecked="True" Click="ShowTimeline_Click" />
                 <MenuItem x:Name="IssueLogsMenuItem" Header="Avisos" IsCheckable="True" IsChecked="True" Click="ShowIssueLogs_Click" />
                 <MenuItem x:Name="FullTestMenuItem" Header="Teste completo" IsCheckable="True" IsChecked="True" Click="ShowFullTest_Click" />
            </MenuItem>
            <MenuItem Header="_Ferramentas">
                <MenuItem Header="Verificar dispositivo Modbus..." Click="VerifyDiscoveredDevice_Click" IsEnabled="{Binding CanConfigureFullTest}" />
                <MenuItem Header="Configurar escopo do teste..." Click="ConfigureFullTestScope_Click" IsEnabled="{Binding CanConfigureFullTest}" />
                <MenuItem Header="Configurar descoberta de mapa..." Click="ConfigureMapDiscovery_Click" IsEnabled="{Binding CanConfigureFullTest}" />
                <MenuItem Header="O que o teste verifica?" Click="FullTestHelp_Click" />
            </MenuItem>
            <MenuItem Header="_Ajuda">
                <MenuItem x:Name="ManualHelpMenuItem" Header="Manual técnico" InputGestureText="F1" Click="ManualMenuItem_Click" />
                <Separator />
                <MenuItem Header="Sobre" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#E8EEF2" BorderBrush="#BAC8D2" BorderThickness="0,0,0,1" Padding="4,3">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MainToolbar" Orientation="Horizontal">
                    <Button Style="{StaticResource RibbonCommandButton}" Width="70" Click="NewSession_Click" ToolTip="Iniciar uma nova sessão de diagnóstico">
                        <StackPanel><Image Source="{StaticResource ToolbarNewIcon}" Width="25" Height="26" HorizontalAlignment="Center" /><TextBlock Text="Novo" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonCommandButton}" Width="70" Command="{Binding SaveConfigurationCommand}" ToolTip="Salvar clientes, servidor e mapas em arquivo .ffd">
                        <StackPanel><Image Source="{StaticResource ToolbarSaveIcon}" Width="25" Height="26" HorizontalAlignment="Center" /><TextBlock Text="Salvar" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                    <Border Width="1" Height="46" Background="#B9C7D0" Margin="7,7" />
                    <Button Style="{StaticResource RibbonCommandButton}" Click="ConfigureClient_Click" IsEnabled="{Binding CanConfigureClient}" ToolTip="{Binding SelectedClientSession.Endpoint, StringFormat=Configurar somente o alvo selecionado: {0}}">
                        <StackPanel><Grid Width="29" Height="29" HorizontalAlignment="Center"><Image Source="{StaticResource ToolbarClientIcon}" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" /><Ellipse Width="14" Height="14" Fill="#E49B31" Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" /><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" /></Grid><TextBlock Text="Configurar alvo" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonCommandButton}" Command="{Binding StartClientScanCommand}" ToolTip="{Binding SelectedClientSession.Endpoint, StringFormat=Conectar e iniciar leitura somente deste alvo: {0}}">
                        <StackPanel><Grid Width="29" Height="29" HorizontalAlignment="Center"><Image Source="{StaticResource ToolbarClientIcon}" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" /><Ellipse Width="14" Height="14" Fill="#31A565" Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" /><TextBlock Text="+" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" /></Grid><TextBlock Text="Conectar alvo" FontSize="10" TextAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonCommandButton}" Command="{Binding DisconnectClientCommand}" ToolTip="{Binding SelectedClientSession.Endpoint, StringFormat=Desconectar somente este alvo: {0}}">
                        <StackPanel><Grid Width="29" Height="29" HorizontalAlignment="Center"><Image Source="{StaticResource ToolbarClientIcon}" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" /><Ellipse Width="14" Height="14" Fill="#D7554D" Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" /><TextBlock Text="×" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" /></Grid><TextBlock Text="Desconectar" FontSize="10" TextAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                    <Border Width="1" Height="46" Background="#B9C7D0" Margin="7,7" />
                    <Button Style="{StaticResource RibbonCommandButton}" Click="ConfigureServer_Click" IsEnabled="{Binding CanConfigureServer}" ToolTip="Configurar servidor Modbus TCP">
                        <StackPanel><Grid Width="29" Height="29" HorizontalAlignment="Center"><Image Source="{StaticResource ToolbarServerIcon}" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" /><Ellipse Width="14" Height="14" Fill="#E49B31" Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" /><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" /></Grid><TextBlock Text="Configurar servidor" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonCommandButton}" Command="{Binding StartServerCommand}" ToolTip="{Binding ServerEndpoint, StringFormat=Iniciar o servidor simulado local: {0}}">
                        <StackPanel><Grid Width="29" Height="29" HorizontalAlignment="Center"><Image Source="{StaticResource ToolbarServerIcon}" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" /><Ellipse Width="14" Height="14" Fill="#31A565" Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" /><TextBlock Text="+" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" /></Grid><TextBlock Text="Iniciar servidor" FontSize="10" TextAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonCommandButton}" Command="{Binding StopServerCommand}" ToolTip="Parar e desconectar o servidor">
                        <StackPanel><Grid Width="29" Height="29" HorizontalAlignment="Center"><Image Source="{StaticResource ToolbarServerIcon}" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" /><Ellipse Width="14" Height="14" Fill="#D7554D" Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" /><TextBlock Text="×" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" /></Grid><TextBlock Text="Desconectar" FontSize="10" TextAlignment="Center" Margin="0,2,0,0" /></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="ShellGrid" Grid.Row="2" Margin="0">
            <Grid.ColumnDefinitions>
                 <ColumnDefinition x:Name="ConnectionsColumn" Width="260" />
                <ColumnDefinition x:Name="ConnectionsSplitterColumn" Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
             <Border x:Name="ConnectionsPane" Grid.Column="0" Background="#F2F6FA" BorderBrush="#C5D0D7" BorderThickness="0,0,1,0" Padding="5">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="3,1,3,8">
                        <Button DockPanel.Dock="Right" Content="×" Click="HideConnectionsPane_Click" ToolTip="Ocultar painel de conexões" Width="26" Height="25" Padding="0" Margin="0" />
                         <TextBlock Text="Conexões" FontSize="12" FontWeight="SemiBold" Foreground="#18354B" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Expander IsExpanded="True" Margin="0,0,0,4">
                                <Expander.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource ToolbarClientIcon}" Width="18" Height="18" Margin="0,0,7,0" /><Button Content="Estação cliente / Mestre" Click="ShowClientStation_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" FontWeight="SemiBold" ToolTip="Abrir a estação e gerenciar todos os servidores-alvo"/></StackPanel></Expander.Header>
                                <StackPanel Margin="7,5,0,7">
                                    <TextBlock Text="{Binding RunningClientCount, StringFormat=Conexões em leitura: {0}}" Foreground="#637F92" FontSize="11" Margin="3,0,0,5" />
                                    <ListBox x:Name="ClientTargetList" ItemsSource="{Binding ClientSessions}" SelectedItem="{Binding SelectedClientSession, Converter={StaticResource RequiredSelection}}" IsEnabled="{Binding CanConfigureFullTest}" Background="Transparent" BorderThickness="0" PreviewMouseLeftButtonDown="ClientTargetList_PreviewMouseLeftButtonDown" SelectionChanged="ClientTargetList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,2" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SessionBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SessionBorder" Property="Background" Value="#DDECF7" /><Setter TargetName="SessionBorder" Property="BorderBrush" Value="#76A5C6" /></Trigger><DataTrigger Binding="{Binding DataContext.IsServerMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter TargetName="SessionBorder" Property="Background" Value="Transparent" /><Setter TargetName="SessionBorder" Property="BorderBrush" Value="Transparent" /></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><DockPanel ToolTip="{Binding LastError}">
                                            <Image DockPanel.Dock="Left" Source="{StaticResource ToolbarClientIcon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,3,7,0" />
                                            <StackPanel><TextBlock Text="{Binding Name}" Foreground="#234B67" FontWeight="SemiBold" /><TextBlock Text="{Binding Endpoint}" Foreground="#526B7D" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Fill="{Binding StateColor}" Width="7" Height="7" Margin="0,0,5,0" /><TextBlock Text="{Binding ConnectionState}" Foreground="{Binding StateColor}" FontSize="11" /></StackPanel></StackPanel>
                                        </DockPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Nenhum alvo cadastrado" Foreground="#637F92" Margin="4,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasClientTargets}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
