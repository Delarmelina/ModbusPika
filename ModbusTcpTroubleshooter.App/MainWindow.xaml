<TabItem x:Name="FullTestTab" Style="{StaticResource WorkspaceTab}">
 <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#319568" Margin="0,0,7,0"/><TextBlock Text="Teste completo"/></StackPanel></TabItem.Header>
 <DockPanel TextElement.FontWeight="Normal">
