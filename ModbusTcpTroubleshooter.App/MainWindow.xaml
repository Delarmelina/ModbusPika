                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#9AA39C" /><Style.Triggers><DataTrigger Binding="{Binding IsServerRunning}" Value="True"><Setter Property="Fill" Value="#2E7D32" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding LocalIp}" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" />
