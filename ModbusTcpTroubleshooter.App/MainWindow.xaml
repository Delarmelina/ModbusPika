                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="Estado: " Foreground="#5B665F" /><TextBlock Style="{StaticResource ServerStateText}" FontWeight="SemiBold" /></StackPanel>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>
                        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
