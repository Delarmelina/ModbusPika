                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Cliente / leitura ritmada" Foreground="#5B665F" /><TextBlock Grid.Column="1" Style="{StaticResource ScanStateText}" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Servidor simulado" Foreground="#5B665F" /><TextBlock Grid.Column="1" Style="{StaticResource ServerStateText}" FontWeight="SemiBold" /></Grid>
                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Captura passiva" Foreground="#5B665F" /><TextBlock Grid.Column="1" Style="{StaticResource CaptureStateText}" FontWeight="SemiBold" /></Grid>
                                    <TextBlock Text="{Binding Status}" Foreground="#35433B" TextWrapping="Wrap" Margin="0,8,0,0" />
