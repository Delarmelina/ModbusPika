                            <TabItem Header="Mapa de comunicacao">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Pontos recebidos do dispositivo" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                    <TabControl>
                                        <TabItem Header="HR">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientHoldingRegisterPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="ClientCommunicationGrid_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridCheckBoxColumn Header="Escr." Binding="{Binding Writable}" Width="55" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="IR">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientInputRegisterPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="COIL">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientCoilPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="ClientCommunicationGrid_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="DISCRETE">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientDiscreteInputPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10"
                            Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibility}}">
                        <TabControl>
                            <TabItem Header="Configurar faixas">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Faixas disponibilizadas pelo servidor" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button Content="Adicionar faixa" Command="{Binding AddServerRangeCommand}" />
                                        <Button Content="Remover faixa" Command="{Binding RemoveServerRangeCommand}" />
