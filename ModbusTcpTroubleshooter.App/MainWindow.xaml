<Window x:Class="ModbusTcpTroubleshooter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Modbus TCP Troubleshooter" Height="790" Width="1280" MinHeight="700" MinWidth="1120"
        Background="#F2F4F1">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="Export Case" Command="{Binding SaveCaseCommand}" />
                <MenuItem Header="Export Full Test Report" Command="{Binding SaveFullTestReportCommand}" />
                <Separator />
                <MenuItem Header="Sair" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Connect" Click="ShowConnectMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ShowMapMenuItem" Header="Show Map" IsCheckable="True" IsChecked="True" Click="ShowMapMenuItem_Click" />
                <MenuItem x:Name="ShowDiagnosticsMenuItem" Header="Show Diagnostics" IsCheckable="True" IsChecked="True" Click="ShowDiagnosticsMenuItem_Click" />
                <MenuItem x:Name="ShowTimelineMenuItem" Header="Show Timeline" IsCheckable="True" IsChecked="True" Click="ShowTimelineMenuItem_Click" />
                <Separator />
                <MenuItem Header="Focus Map" Click="FocusMapMenuItem_Click" />
                <MenuItem Header="Focus Diagnostics" Click="FocusDiagnosticsMenuItem_Click" />
                <MenuItem Header="Focus Timeline" Click="FocusTimelineMenuItem_Click" />
                <MenuItem Header="Large Timeline" Click="LargeTimelineMenuItem_Click" />
                <MenuItem Header="Reset Layout" Click="ResetLayoutMenuItem_Click" />
                <Separator />
                <MenuItem Header="Abas no topo" Click="TabsTopMenuItem_Click" />
                <MenuItem Header="Abas na esquerda" Click="TabsLeftMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Leitura unica" Command="{Binding ReadOnceCommand}" />
                <MenuItem Header="Iniciar scan" Command="{Binding StartClientScanCommand}" />
                <MenuItem Header="Parar scan" Command="{Binding StopClientScanCommand}" />
                <Separator />
                <MenuItem Header="Iniciar servidor" Command="{Binding StartServerCommand}" />
                <MenuItem Header="Parar servidor" Command="{Binding StopServerCommand}" />
                <Separator />
                <MenuItem Header="Start Capture" Command="{Binding StartNetworkCaptureCommand}" />
                <MenuItem Header="Stop Capture" Command="{Binding StopNetworkCaptureCommand}" />
                <MenuItem Header="Clear Timeline" Command="{Binding ClearTimelineCommand}" />
                <Separator />
                <MenuItem Header="Teste completo" Command="{Binding StartFullTestCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Sobre" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <DockPanel Grid.Row="1" Margin="16,12,16,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Modbus TCP Troubleshooter" FontSize="24" FontWeight="SemiBold" Foreground="#17312B" />
                <TextBlock Text="{Binding Status}" Foreground="#5B665F" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Connect" Click="ShowConnectMenuItem_Click" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsClientMode, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Read Once" Command="{Binding ReadOnceCommand}" />
                    <Button Content="Start Scan" Command="{Binding StartClientScanCommand}" />
                    <Button Content="Stop Scan" Command="{Binding StopClientScanCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Start Server" Command="{Binding StartServerCommand}" />
                    <Button Content="Stop Server" Command="{Binding StopServerCommand}" />
                </StackPanel>
                <Button Content="Start Capture" Command="{Binding StartNetworkCaptureCommand}" />
                <Button Content="Stop Capture" Command="{Binding StopNetworkCaptureCommand}" />
                <Button Content="Full Test" Command="{Binding StartFullTestCommand}" />
                <Button Content="Export" Command="{Binding SaveCaseCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid x:Name="ShellGrid" Grid.Row="2" Margin="16,0,16,0">
            <TabControl x:Name="MainTabs">
                <TabItem Header="Operacao">
                    <TabControl x:Name="OperationTabs" Margin="0,8,0,0">
                        <TabItem Header="Connect">
                            <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                        <TextBlock Text="Connection setup" FontSize="18" FontWeight="SemiBold" Foreground="#17312B" />
                                        <TextBlock Text="Configure the troubleshooting role and connection parameters." Foreground="#5B665F" Margin="0,3,0,16" />
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Case name" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding CaseName, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Operational mode" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
                                        </Grid>

                                        <Border Visibility="{Binding IsClientMode, Converter={StaticResource BoolToVisibility}}" Background="#F7F9F7" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="4" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Modbus TCP Client" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" />
                                                <TextBlock Text="Connect to an existing Modbus TCP server and execute configured reads." Foreground="#5B665F" Margin="0,3,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="Target IP" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding TargetIp, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="2" Text="Unit ID" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="3" Text="Scan rate (ms)" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ScanRateMs, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <WrapPanel Margin="0,14,0,0"><Button Content="Read Once" Command="{Binding ReadOnceCommand}" /><Button Content="Start Scan" Command="{Binding StartClientScanCommand}" /><Button Content="Stop Scan" Command="{Binding StopClientScanCommand}" /></WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibility}}" Background="#F7F9F7" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="4" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Modbus TCP Server" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" />
                                                <TextBlock Text="Expose the configured map as a replacement Modbus TCP server." Foreground="#5B665F" Margin="0,3,0,12" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="Listen IP" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding LocalIp, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="2" Text="Unit ID" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <WrapPanel Margin="0,14,0,0"><Button Content="Start Server" Command="{Binding StartServerCommand}" /><Button Content="Stop Server" Command="{Binding StopServerCommand}" /></WrapPanel>
                                                <TextBlock Text="Use port 1502 for local testing. Port 502 can require administrator permission." TextWrapping="Wrap" Foreground="#6D756E" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                        <TabItem Header="Workspace">
                    <Grid x:Name="OperationLayoutGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopPanelsRow" Height="1.05*" />
                    <RowDefinition x:Name="TimelineSplitterRow" Height="6" />
                    <RowDefinition x:Name="TimelineRow" Height="1.25*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TopPanelsGrid" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MapColumn" Width="1.35*" />
                        <ColumnDefinition x:Name="MapSplitterColumn" Width="6" />
                        <ColumnDefinition x:Name="DiagnosticsColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="MapPane" Grid.Column="0" Margin="0,0,8,8">
                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10"
                            Visibility="{Binding IsClientMode, Converter={StaticResource BoolToVisibility}}">
                        <TabControl>
                            <TabItem Header="Configurar leituras">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Mapa do client" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button Content="Adicionar linha" Command="{Binding AddClientMapRowCommand}" />
                                        <Button Content="Remover linha" Command="{Binding RemoveClientMapRowCommand}" />
                                        <TextBlock Text="Duplo clique na linha para escrever HR/COIL gravavel." Foreground="#6D756E" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding ClientMapRows}" SelectedItem="{Binding SelectedClientMapRow}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="ClientMapGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45" />
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                                            <DataGridTemplateColumn Header="FC" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Function}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding Functions}" SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Endereco" Binding="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                            <DataGridTextColumn Header="Ultimo valor" Binding="{Binding LastValue}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding LastStatus}" Width="150" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Hora" Binding="{Binding LastReadAt}" Width="90" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Mapa de comunicacao">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Pontos lidos pelo client" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                    <TabControl>
                                        <TabItem Header="HR">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientHoldingRegisterPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="ClientCommunicationGrid_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridCheckBoxColumn Header="Escr." Binding="{Binding Writable}" Width="55" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="IR">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientInputRegisterPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="COIL">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientCoilPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="ClientCommunicationGrid_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="DISCRETE">
                                            <DataGrid Margin="0,8,0,0" ItemsSource="{Binding ClientDiscreteInputPoints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Linha" Binding="{Binding SourceLine}" Width="130" />
                                                    <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="75" />
                                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="75" />
                                                    <DataGridTextColumn Header="Qualidade" Binding="{Binding Quality}" Width="130" />
                                                    <DataGridTextColumn Header="Hora" Binding="{Binding LastUpdatedAt}" Width="95" />
                                                    <DataGridTextColumn Header="FC" Binding="{Binding Function}" Width="160" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10"
                            Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibility}}">
                        <TabControl>
                            <TabItem Header="Configurar faixas">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Faixas expostas pelo server" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button Content="Adicionar faixa" Command="{Binding AddServerRangeCommand}" />
                                        <Button Content="Remover faixa" Command="{Binding RemoveServerRangeCommand}" />
                                        <Button Content="Aplicar mapa" Command="{Binding ApplyServerMapCommand}" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding ServerMapRanges}" SelectedItem="{Binding SelectedServerMapRange}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="45" />
                                            <DataGridTextColumn Header="Prefixo" Binding="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                            <DataGridTemplateColumn Header="Tipo" Width="145">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Type}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Inicio" Binding="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                            <DataGridTextColumn Header="Valor inicial" Binding="{Binding InitialValue, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                            <DataGridCheckBoxColumn Header="Inc" Binding="{Binding IncrementValue}" Width="45" />
                                            <DataGridCheckBoxColumn Header="R/W" Binding="{Binding Writable}" Width="50" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Visualizar mapa">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Mapa efetivo do server simulado - edite a coluna Valor para alterar a resposta do server" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding ServerPoints}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="130" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Endereco" Binding="{Binding Address}" Width="80" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Valor" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                            <DataGridTextColumn Header="Acesso" Binding="{Binding Access}" Width="65" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Atualizado" Binding="{Binding LastUpdatedAt}" Width="95" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                    </Grid>

                    <GridSplitter x:Name="MapDiagnosticsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D5DDD6" Margin="0,0,0,8" />

                    <Border x:Name="DiagnosticsPane" Grid.Column="2" Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="8,0,0,8">
                        <TabControl>
                            <TabItem Header="Todos">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Diagnosticos" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="75" />
                                            <DataGridTextColumn Header="Nivel" Binding="{Binding Severity}" Width="75" />
                                            <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*" />
                                            <DataGridTextColumn Header="Recomendacao" Binding="{Binding Recommendation}" Width="220" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Avisos importantes">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Resumo de ocorrencias importantes" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding ImportantWarnings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Qtd" Binding="{Binding Count}" Width="45" />
                                            <DataGridTextColumn Header="Nivel" Binding="{Binding Severity}" Width="75" />
                                            <DataGridTextColumn Header="Primeira" Binding="{Binding FirstSeenAt, StringFormat=HH:mm:ss}" Width="75" />
                                            <DataGridTextColumn Header="Ultima" Binding="{Binding LastSeenAt, StringFormat=HH:mm:ss}" Width="75" />
                                            <DataGridTextColumn Header="Resumo" Binding="{Binding Title}" Width="220" />
                                            <DataGridTextColumn Header="Ultimo detalhe" Binding="{Binding LatestDetail}" Width="*" />
                                            <DataGridTextColumn Header="Recomendacao" Binding="{Binding Recommendation}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Checklist">
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Top" Text="Verificacoes automaticas" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding VerificationChecks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="125" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
                                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Hora" Binding="{Binding LastCheckedAt}" Width="75" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>

                <GridSplitter x:Name="TimelineSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#D5DDD6" />

                <Border x:Name="TimelinePane" Grid.Row="2" Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <TabControl>
                        <TabItem Header="Modbus">
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Timeline Modbus TCP" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding Traffic}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="95" />
                                        <DataGridTextColumn Header="Direcao" Binding="{Binding Direction}" Width="115" />
                                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="145" />
                                        <DataGridTextColumn Header="TID" Binding="{Binding TransactionId}" Width="55" />
                                        <DataGridTextColumn Header="UID" Binding="{Binding UnitId}" Width="55" />
                                        <DataGridTextColumn Header="FC" Binding="{Binding FunctionCode}" Width="50" />
                                        <DataGridTextColumn Header="Addr" Binding="{Binding StartAddress}" Width="60" />
                                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="55" />
                                        <DataGridTextColumn Header="Resumo" Binding="{Binding Summary}" Width="*" />
                                        <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" Width="260" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="TCP">
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Interface" />
                                            <ComboBox ItemsSource="{Binding CaptureDevices}" SelectedItem="{Binding SelectedCaptureDevice}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Protocolo" />
                                            <ComboBox ItemsSource="{Binding CaptureProtocols}" SelectedItem="{Binding SelectedCaptureProtocol}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <TextBlock Text="IP" />
                                            <TextBox Text="{Binding CaptureIp, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                            <TextBlock Text="Direcao IP" />
                                            <ComboBox ItemsSource="{Binding CaptureDirections}" SelectedItem="{Binding SelectedCaptureIpDirection}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                            <TextBlock Text="Porta" />
                                            <TextBox Text="{Binding CapturePort, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                            <TextBlock Text="Direcao porta" />
                                            <ComboBox ItemsSource="{Binding CaptureDirections}" SelectedItem="{Binding SelectedCapturePortDirection}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="6" VerticalAlignment="Bottom">
                                            <Button Content="Atualizar interfaces" Command="{Binding RefreshCaptureDevicesCommand}" />
                                            <Button Content="Atualizar filtro" Command="{Binding ApplyCaptureFilterCommand}" />
                                            <Button Content="Iniciar captura" Command="{Binding StartNetworkCaptureCommand}" />
                                            <Button Content="Parar captura" Command="{Binding StopNetworkCaptureCommand}" />
                                        </WrapPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.6*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Filtro Source" />
                                            <TextBox Text="{Binding SourceColumnFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Filtro Destination" />
                                            <TextBox Text="{Binding DestinationColumnFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <TextBlock Text="Filtro Protocol" />
                                            <TextBox Text="{Binding ProtocolColumnFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                            <TextBlock Text="Filtro Info" />
                                            <TextBox Text="{Binding InfoColumnFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="BPF gerado" />
                                            <TextBox Text="{Binding GeneratedCaptureFilter}" IsReadOnly="True" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Foreground="#6D756E" Text="{Binding QueuedPassivePackets, StringFormat=Captura passiva da interface. Pacotes pendentes na fila de UI: {0}}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding FilteredTcpTimeline}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="TcpTimelineGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="55" />
                                        <DataGridTextColumn Header="Time" Binding="{Binding RelativeTime, StringFormat=0.000000}" Width="95" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" />
                                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="150" />
                                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="95" />
                                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="70" />
                                        <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
                    </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
                <TabItem Header="Teste completo">
                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <WrapPanel Margin="0,0,0,10">
                                    <TextBlock Text="Teste completo de rede Modbus" FontSize="16" FontWeight="SemiBold" Foreground="#17312B" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Content="Executar teste completo" Command="{Binding StartFullTestCommand}" />
                                    <Button Content="Exportar relatorio" Command="{Binding SaveFullTestReportCommand}" />
                                    <CheckBox Content="Varredura ativa da sub-rede" IsChecked="{Binding EnableActiveSubnetScan}" VerticalAlignment="Center" Margin="14,0,8,0" />
                                    <CheckBox Content="Descoberta de mapa" IsChecked="{Binding EnableMapDiscovery}" VerticalAlignment="Center" Margin="8,0,8,0" />
                                    <TextBlock Text="Timeout ms" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B665F" />
                                    <TextBox Text="{Binding ActiveScanTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                                    <TextBlock Text="Concorrencia" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B665F" />
                                    <TextBox Text="{Binding ActiveScanConcurrency, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                                    <TextBlock Text="Observacao s" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B665F" />
                                    <TextBox Text="{Binding PassiveObservationSeconds, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <TextBlock Text="Descoberta de mapa:" FontWeight="SemiBold" Foreground="#17312B" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Mapa ate" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#5B665F" />
                                    <TextBox Text="{Binding MapDiscoveryMaxAddress, UpdateSourceTrigger=PropertyChanged}" Width="54" />
                                    <TextBlock Text="Bloco" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B665F" />
                                    <TextBox Text="{Binding MapDiscoveryBlockSize, UpdateSourceTrigger=PropertyChanged}" Width="42" />
                                    <CheckBox Content="Fallback ponto a ponto" IsChecked="{Binding EnableMapDiscoveryPointFallback}" VerticalAlignment="Center" Margin="10,0,8,0" />
                                    <CheckBox Content="Unit sweep" IsChecked="{Binding EnableMapDiscoveryUnitSweep}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <TextBlock Text="UID ini" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B665F" />
                                    <TextBox Text="{Binding MapDiscoveryUnitIdStart, UpdateSourceTrigger=PropertyChanged}" Width="38" />
                                    <TextBlock Text="UID fim" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#5B665F" />
                                    <TextBox Text="{Binding MapDiscoveryUnitIdEnd, UpdateSourceTrigger=PropertyChanged}" Width="38" />
                                    <TextBlock Text="FCs" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#5B665F" />
                                    <CheckBox Content="01" IsChecked="{Binding MapDiscoveryFc01}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <CheckBox Content="02" IsChecked="{Binding MapDiscoveryFc02}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <CheckBox Content="03" IsChecked="{Binding MapDiscoveryFc03}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <CheckBox Content="04" IsChecked="{Binding MapDiscoveryFc04}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </WrapPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Status geral" Foreground="#5B665F" />
                                            <TextBlock Text="{Binding FullTestOverallStatus}" FontSize="18" FontWeight="SemiBold" Foreground="#17312B" />
                                            <TextBlock Text="{Binding FullTestScore}" Foreground="#5B665F" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Rede / hosts" Foreground="#5B665F" />
                                            <TextBlock Text="{Binding FullTestNetworkSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#17312B" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Modbus descoberto" Foreground="#5B665F" />
                                            <TextBlock Text="{Binding FullTestModbusSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#17312B" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Rotas / gateway" Foreground="#5B665F" />
                                            <TextBlock Text="{Binding FullTestRouteSummary}" TextWrapping="Wrap" Foreground="#17312B" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FFFFFF" BorderBrush="#D5DDD6" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Banda / carga" Foreground="#5B665F" />
                                            <TextBlock Text="{Binding FullTestBandwidthSummary}" TextWrapping="Wrap" Foreground="#17312B" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            <TabControl>
                                <TabItem Header="Checklist">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DataGrid Grid.Column="0" ItemsSource="{Binding FullTestSteps}" SelectedItem="{Binding SelectedFullTestStep}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="30">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="●" Foreground="{Binding StatusColor}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="35" />
                                                <DataGridTextColumn Header="Etapa" Binding="{Binding Name}" Width="170" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85" />
                                                <DataGridTextColumn Header="Objetivo" Binding="{Binding Objective}" Width="*" />
                                                <DataGridTextColumn Header="Recomendacao" Binding="{Binding Recommendation}" Width="260" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D5DDD6" />
                                        <DockPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock DockPanel.Dock="Top" Text="Detalhe da etapa selecionada" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                            <TextBox Text="{Binding SelectedFullTestStep.Result}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                        </DockPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Dispositivos / rede">
                                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding NetworkDiscoveryRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="120" />
                                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140" />
                                            <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="160" />
                                            <DataGridTextColumn Header="Papel provavel" Binding="{Binding RoleGuess}" Width="200" />
                                            <DataGridTextColumn Header="Portas/Modbus" Binding="{Binding ModbusStatus}" Width="145" />
                                            <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Mapa descoberto">
                                    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding DiscoveredMapRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="145" />
                                            <DataGridTextColumn Header="Unit ID" Binding="{Binding UnitId}" Width="65" />
                                            <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="170" />
                                            <DataGridTextColumn Header="Inicio" Binding="{Binding StartAddress}" Width="70" />
                                            <DataGridTextColumn Header="Fim" Binding="{Binding EndAddress}" Width="70" />
                                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="60" />
                                            <DataGridTextColumn Header="Modo" Binding="{Binding DiscoveryMode}" Width="115" />
                                            <DataGridTextColumn Header="Confianca" Binding="{Binding Confidence}" Width="130" />
                                            <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Relatorio">
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="Relatorio final exportavel" FontWeight="SemiBold" Foreground="#17312B" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding FullTestReport}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="3" Margin="16,10,16,12" Foreground="#6D756E"
                   Text="Client e Server agora sao configurados separadamente. O mapa do client suporta leitura unica e scan ritmado." />
    </Grid>
</Window>
