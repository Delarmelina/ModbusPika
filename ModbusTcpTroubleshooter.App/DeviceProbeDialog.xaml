<Window x:Class="ModbusTcpTroubleshooter.App.DeviceProbeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificar dispositivo Modbus" Width="580" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F0F0F0">
    <StackPanel Margin="14">
        <TextBlock Text="Sondagem individual, somente leitura" FontWeight="SemiBold" />
        <TextBlock Text="Abre conexoes TCP apenas no IP e nas portas informados e envia uma leitura minima Modbus. Uma exception valida tambem confirma o protocolo. Nao varre a sub-rede nem escreve valores." TextWrapping="Wrap" Margin="0,6,0,10" />
        <Grid x:Name="SettingsGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Endereco IPv4" VerticalAlignment="Center"/><TextBox x:Name="AddressBox" Grid.Column="1" MinHeight="28" Margin="0,3"/>
            <TextBlock Grid.Row="1" Text="Portas TCP" VerticalAlignment="Center"/><TextBox x:Name="PortsBox" Grid.Row="1" Grid.Column="1" MinHeight="28" Margin="0,3"/>
            <TextBlock Grid.Row="2" Text="ID da unidade" VerticalAlignment="Center"/><TextBox x:Name="UnitBox" Grid.Row="2" Grid.Column="1" MinHeight="28" Margin="0,3" Text="1"/>
        </Grid>
        <TextBlock Text="Use o Unit ID do equipamento remoto, nao necessariamente o do servidor simulado local." TextWrapping="Wrap" Foreground="#657785" Margin="0,6"/>
        <TextBox x:Name="ResultBox" Height="155" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,10" Text="Aguardando verificacao. Ao clicar em Verificar, voce autoriza a sondagem do IP informado."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="VerifyButton" Content="Verificar" Width="95" Height="28" IsDefault="True" Click="Verify_Click" Margin="0,0,8,0"/>
            <Button Content="Fechar" Width="85" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
