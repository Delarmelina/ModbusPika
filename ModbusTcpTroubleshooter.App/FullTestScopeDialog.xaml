<Window x:Class="ModbusTcpTroubleshooter.App.FullTestScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procedimentos do teste completo" Width="650" Height="650" MinWidth="610" MinHeight="500"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="40" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <GroupBox Header="Janelas de observacao TCP" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="Referencia inicial antes de novas sondagens; monitoramento final de RST, zero-window, segmentos repetidos e picos. Operacoes previamente ativas continuam." TextWrapping="Wrap" /><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Referencia passiva inicial" VerticalAlignment="Center" /><TextBox x:Name="ObservationTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="s (1 a 3600)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Monitorar linha do tempo TCP por" VerticalAlignment="Center" /><TextBox x:Name="MonitoringTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="s (1 a 86400)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Avisar se pico observado ultrapassar" VerticalAlignment="Center" /><TextBox x:Name="PacketRateTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="pacotes/s" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><TextBlock Text="Limiar operacional, nao medida de saturacao da rede. Captura respeita interface e filtro BPF." Foreground="#5B665F" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></GroupBox>
            <GroupBox Header="Leituras repetidas (Cliente/Mestre)" Padding="10" Margin="0,0,0,8"><StackPanel><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Tentativas por bloco habilitado" VerticalAlignment="Center" /><TextBox x:Name="AttemptsTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="(1 a 1000)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Intervalo adicional entre ciclos" VerticalAlignment="Center" /><TextBox x:Name="ReadIntervalTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="ms (100 a 60000)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><TextBlock Text="Mostra validas/tentativas, tipos de falha e tempos min/mediana/p95/max. Leituras adicionais ao polling existente, sem escrita." Foreground="#5B665F" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></GroupBox>
            <GroupBox Header="Sondagem de outros hosts (opcional)" Padding="10"><StackPanel><CheckBox x:Name="ActiveSubnetScanCheckBox" Content="Autorizo sondagem ativa no CIDR informado" /><TextBlock Text="Nao inclui automaticamente hosts de ARP, Internet ou captura. Somente CIDR explicito e alvos cadastrados. Confirmacao Modbus por leitura minima; sem escrita." Foreground="#5B665F" TextWrapping="Wrap" Margin="0,5" /><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="CIDR (ex.: 192.168.1.0/24)" VerticalAlignment="Center" /><TextBox x:Name="CidrTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Timeout TCP de sondagem" VerticalAlignment="Center" /><TextBox x:Name="TimeoutTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="ms (200 a 3000)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Concorrencia maxima" VerticalAlignment="Center" /><TextBox x:Name="ConcurrencyTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="(1 a 16)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Taxa maxima de sondagens" VerticalAlignment="Center" /><TextBox x:Name="ProbeRateTextBox" Grid.Column="1" Height="28" Padding="4,3" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="tentativas/s (1 a 100)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid></StackPanel></GroupBox>
            <GroupBox Header="Portas para descoberta Modbus" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <CheckBox x:Name="AutomaticScopeCheckBox" Content="Identificar automaticamente a sub-rede da interface (padrao)" IsChecked="True" Margin="0,0,0,6" />
                    <TextBlock Text="Portas TCP (separadas por virgula)" />
                    <TextBox x:Name="DiscoveryPortsTextBox" Height="28" Margin="0,5" ToolTip="Ex.: 502,1501,1502. Ate 16 portas; nao varre todas as 65535 portas." />
                    <TextBlock Text="Todos os IPs da sub-rede serao verificados nessas portas. Nao e necessario cadastrar IPs. Desmarque a deteccao automatica somente para usar o CIDR manual. Descoberta de mapa habilitada: sonda todos os servidores Modbus confirmados. Portas nao listadas nao sao enumeradas; switches silenciosos podem permanecer desconhecidos." TextWrapping="Wrap" Foreground="#5B665F" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Topologia e rastreamento de rotas" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <CheckBox x:Name="TraceRoutesCheckBox" Content="Rastrear rotas ICMP ate os alvos (equivalente ao tracert)" />
                    <TextBlock Text="Uma consulta por TTL, sem DNS. Cliente: alvos selecionados. Servidor: pares Modbus observados. Timeout ICMP nao implica falha Modbus. Switches L2 nao aparecem nos saltos." TextWrapping="Wrap" Foreground="#5B665F" Margin="0,6" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Maximo de saltos por alvo" VerticalAlignment="Center"/><TextBox x:Name="TraceHopsTextBox" Grid.Column="1" Height="28" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="(1 a 30)" VerticalAlignment="Center"/></Grid>
                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Timeout por salto" VerticalAlignment="Center"/><TextBox x:Name="TraceTimeoutTextBox" Grid.Column="1" Height="28" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="ms (200 a 3000)" VerticalAlignment="Center"/></Grid>
                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Maximo de alvos rastreados" VerticalAlignment="Center"/><TextBox x:Name="TraceTargetsTextBox" Grid.Column="1" Height="28" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="(1 a 32)" VerticalAlignment="Center"/></Grid>
                    <TextBlock Text="Anuncios LLDP/CDP sao recebidos passivamente durante a captura. Se houver filtro IP/porta/protocolo, esses anuncios podem ser excluidos. Nao ha consulta SNMP nem configuracao dos switches." TextWrapping="Wrap" Foreground="#5B665F" Margin="0,7,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel></ScrollViewer>
        <TextBlock x:Name="ValidationText" Grid.Row="1" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,6" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="OK" Width="82" Height="28" Margin="0,0,12,0" IsDefault="True" Click="Confirm_Click" />
            <Button Content="Cancelar" Width="82" Height="28" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
