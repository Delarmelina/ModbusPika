<Window x:Class="ModbusTcpTroubleshooter.App.FullTestScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full Test Scope"
        Width="500"
        Height="410"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <StackPanel>
            <GroupBox Header="Network discovery" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="ActiveSubnetScanCheckBox" Content="Enable active subnet scan" Margin="0,0,0,5" />
                    <TextBlock Text="Attempts TCP connections to candidate hosts in the local subnet. Use only on networks where active probing is authorized." TextWrapping="Wrap" Foreground="#5B665F" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Probe timeout" VerticalAlignment="Center" />
                        <TextBox x:Name="TimeoutTextBox" Grid.Column="1" Width="70" Height="26" Padding="4,2" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="ms per endpoint" VerticalAlignment="Center" Foreground="#5B665F" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Parallel probes" VerticalAlignment="Center" />
                        <TextBox x:Name="ConcurrencyTextBox" Grid.Column="1" Width="70" Height="26" Padding="4,2" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="simultaneous TCP attempts" VerticalAlignment="Center" Foreground="#5B665F" />
                    </Grid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Passive observation" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Observation window" VerticalAlignment="Center" />
                    <TextBox x:Name="ObservationTextBox" Grid.Column="1" Width="70" Height="26" Padding="4,2" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="2" Text="seconds captured for timing and load analysis" VerticalAlignment="Center" Foreground="#5B665F" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="1" Foreground="#B3261E" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="OK" Width="82" Height="26" Margin="0,0,14,0" IsDefault="True" Click="Confirm_Click" />
            <Button Content="Cancel" Width="82" Height="26" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
